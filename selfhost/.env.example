# Copy to .env and fill in locally. Never commit .env or real credentials.
PG_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_PASSWORD

# Existing OpenAI-compatible model gateway; base URL excludes /v1.
LLM_BASE=https://llm.example.org
LLM_KEY=REPLACE_WITH_YOUR_GATEWAY_API_KEY
LLM_MODEL=REPLACE_WITH_YOUR_MODEL_NAME

FOLLOWUP_VOICE=xiaoxiao
FOLLOWUP_VOICE_SPEED=calm

# Add telephony/.env.telephony.example settings only when setting up a line.
TELEPHONY_ENABLED=0
