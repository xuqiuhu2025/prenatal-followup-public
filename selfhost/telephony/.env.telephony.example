# Copy these settings into the existing selfhost/.env after the SIP provider approves the line.
# Leave TELEPHONY_ENABLED=0 until Asterisk, firewall and the authorized test number are ready.
TELEPHONY_ENABLED=0
AMI_HOST=host.docker.internal
AMI_PORT=5038
AMI_USERNAME=hospital-followup
AMI_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
TELEPHONY_TRUNK=hospital-followup
TELEPHONY_CALLER_ID=REPLACE_WITH_ASSIGNED_HOSPITAL_NUMBER
TELEPHONY_DIAL_PREFIX=
# Replace these with a private/restricted network route from Asterisk to the app.
TELEPHONY_MEDIA_TARGET=REPLACE_WITH_PRIVATE_HOST:9092
TELEPHONY_MEDIA_PUBLISH=REPLACE_WITH_PRIVATE_BIND_IP:9092:9092
TELEPHONY_MEDIA_PEERS=REPLACE_WITH_ASTERISK_PRIVATE_IP
TELEPHONY_MEDIA_HOST=0.0.0.0
TELEPHONY_TEST_NUMBERS=
TELEPHONY_CENTER_NAME=产前筛查与诊断中心
TELEPHONY_RING_SECONDS=30
TELEPHONY_MAX_SECONDS=480
TELEPHONY_CONCURRENCY=1
TELEPHONY_START_HOUR=9
TELEPHONY_END_HOUR=18
TELEPHONY_VAD_RMS=600
TELEPHONY_SILENCE_MS=800
